<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ToDoList.ViewModels"
             x:Class="ToDoList.MainPage">
    <StackLayout Padding="10">

        <Image Source="rocco.png" HorizontalOptions="Center" />
        <Label Text="{Binding CompletedTaskSummary}" FontSize="20" HorizontalOptions="Center" />
        <Entry x:Name="Request" Placeholder="Enter a new Task" Text="{Binding NewTaskTitle}"/>
        <!--should I use a Clicked or a Command with a binding-->
        <!--It seems like I can't use the clicked command with the mvvm architecture as it would rrequire implementing the event handler in the MainPage.xaml.cs file-->
        <Button Text="Add Task" Command="{Binding AddTaskCommand}" />

        <CollectionView ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
                        
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center" />
                        <ImageButton Grid.Column="2" Source="bin.png" Command="{Binding DeleteTaskCommand,Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}}" 
                                VerticalOptions="End" CommandParameter="{Binding .}"
                                     WidthRequest="24" HeightRequest="24"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>

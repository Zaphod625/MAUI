<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namepace:ToDoLIst"
             x:DataType="Model:viewmodel:MainViewModel"
             x:Class="ToDoList.MainPage">
    
    
    <StackLayout Margin="10">
        <Label Text="{Binding CompletedTaskSummary}" FontSize="20" HorizontalOptions="Center"/>
        <!--This binds the items collection from the mainpage to the CollectionView-->
        <CollectionView ItemsSource="{Binding Items}" Margin="10">
            <CollectionView.ItemTemplate>
                <!--Datatemplate describes how to display/appear each item from the collection-->
                <DataTemplate>
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <!--This is where the actual data binding occursto the UI-->
                        <Label Text="{Binding Title}" VerticalOptions="Center"/>
                        <CheckBox IsChecked="{Binding IsCompleted}" VerticalOptions="Center"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>

</ContentPage>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Menu.ViewModels"
             x:Class="Menu.Views.MainPage">
    <ScrollView>
        <StackLayout Padding="10">
            <Image Source="rocco.png" HorizontalOptions="Center" WidthRequest="1000" HeightRequest="100"/>
            <Label Text="{Binding CompletedTaskSummary}" FontSize="20" HorizontalOptions="Center" />
            <Label Text="{Binding Total}" FontSize="20" HorizontalOptions="Center" />
            <Entry x:Name="NewTask" Placeholder="Enter a new menu item" Text="{Binding NewTaskTitle}"/>
            <Entry x:Name="NewTaskPrice" Placeholder="Enter the price" Text="{Binding NewTaskPrice}"/>
            <!--should I use a Clicked or a Command with a binding-->
            <!--It seems like I can't use the clicked command with the mvvm architecture as it would rrequire implementing the event handler in the MainPage.xaml.cs file-->
            <Button Text="Request" Command="{Binding AddTaskCommand}" />

            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="5" ColumnDefinitions="Auto,*,*,Auto" RowDefinitions="Auto">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding Price, StringFormat='{}{0:C}'}" VerticalOptions="Center" />
                            <ImageButton Grid.Column="3" Source="bin.png"   Command="{Binding DeleteTaskCommand,Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}}" 
                            VerticalOptions="End" CommandParameter="{Binding .}"
                                 WidthRequest="24" HeightRequest="24"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Complete Order" BackgroundColor="ForestGreen" Command="{Binding NavigateToCartCommand}"/>
            <Button Text="Sign Out" BackgroundColor="DarkRed" Command="{Binding SignOutCommand}"/>
        </StackLayout>
    </ScrollView>
</ContentPage>

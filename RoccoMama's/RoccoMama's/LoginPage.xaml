<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Menu.Models"
             x:Class="Menu.ViewModels">

    <ContentPage.BindingContext>
        <vm:LoginPageViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">

        <Label Text="Login" FontSize="24" HorizontalOptions="Center" />

        <Entry Placeholder="Username" Text="{Binding UsernameInput}" />
        <Entry Placeholder="Password" Text="{Binding PasswordInput}" IsPassword="True" />

        <Button Text="Login" Command="{Binding NavigateToMainCommand}" />
    </VerticalStackLayout>
</ContentPage>